#!/usr/sbin/nft -f
flush ruleset

table inet zon {
    chain in {
        type filter hook input priority 0; policy drop;

        ct state established,related accept
        ct state invalid drop
        iif "lo" accept

        ip saddr 172.20.1.2 tcp dport 22 accept comment "D1 SSH fran jump"
        ip saddr 172.20.1.10 tcp dport 22 accept comment "D2 SSH fran ctf"

        limit rate 10/minute log prefix "ZON-IN-DROP " level info
    }

    chain ut {
        type filter hook output priority 0; policy drop;

        ct state established,related accept
        oif "lo" accept

        ip daddr { 185.12.64.1, 185.12.64.2 } udp dport 53 accept comment "D3 DNS UDP"
        ip daddr { 185.12.64.1, 185.12.64.2 } tcp dport 53 accept comment "D3 DNS TCP"
        udp dport 123 accept comment "D4 NTP"
        ip daddr 172.20.1.58 tcp dport 514 accept comment "D5 Loggserver"
        udp sport 68 udp dport 67 accept comment "D6 DHCP"
	tcp dport 443 accept comment "D7 Paketuppdateringar"

        limit rate 10/minute log prefix "ZON-UT-DROP " level info
    }
}
